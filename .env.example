# Public website origin. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Booking and contact details. Public variables are embedded at build time.
# WhatsApp number must include country code and digits only (example: 6281234567890).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Nailea! I would like to book a nail appointment in Bali.
# Optional localized defaults used after visitors switch language.
NEXT_PUBLIC_WHATSAPP_MESSAGE_ID=Halo Nailea! Saya ingin memesan janji temu kuku di Bali.
NEXT_PUBLIC_WHATSAPP_MESSAGE_RU=Здравствуйте, Nailea! Я хочу записаться на маникюр на Бали.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_BUSINESS_EMAIL=

# Comma-separated names shown as the current travel area summary.
# Route availability is always confirmed individually before booking.
NEXT_PUBLIC_SERVICE_AREAS=Canggu,Seminyak,Kerobokan,Ubud,Sanur,Uluwatu

# Optional search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional analytics and advertising integrations.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_YANDEX_WEBVISOR=false
NEXT_PUBLIC_META_PIXEL_ID=
